{
  "schemaVersion": 1,
  "id": "com.acme.pm3000",
  "name": "ACME PM3000 三相电表",
  "vendor": "ACME",
  "description": "示例设备包：Modbus RTU 三相电表，覆盖 u16/u32/i32/BCD/位展开/可写点的典型用法",
  "version": "1.2.0",
  "minHostVersion": "0.1.0",
  "ui": {
    "pages": [
      {
        "id": "overview",
        "title": "设备概览",
        "icon": "pulse",
        "components": [{ "kind": "overview" }]
      },
      {
        "id": "dashboard",
        "title": "仪表盘",
        "icon": "layout",
        "components": [{ "kind": "dashboard" }]
      },
      {
        "id": "tags",
        "title": "实时点表",
        "icon": "grid",
        "components": [{ "kind": "tags" }]
      },
      {
        "id": "settings",
        "title": "参数设置",
        "icon": "settings",
        "components": [{ "kind": "settings" }]
      }
    ]
  },
  "protocol": {
    "driver": "modbus-rtu",
    "defaults": {
      "byteOrder": "abcd",
      "respTimeoutMs": 150
    }
  }
}
