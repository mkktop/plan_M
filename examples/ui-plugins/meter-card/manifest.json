{
  "schemaVersion": 1,
  "id": "com.example.meter-card",
  "name": "示例插件 · 仪表卡片",
  "version": "1.0.0",
  "sdkVersion": 1,
  "description": "框架无关的 ESM UI 插件示例：一个带阈值环的仪表盘卡片，以及一个独立导航页。",
  "author": "plan_M",
  "entry": "index.js",
  "permissions": ["tags:subscribe", "notify"],
  "widgets": [
    {
      "id": "meter",
      "name": "仪表卡片",
      "description": "绑定任意数值 tag，显示数值/单位/质量与进度环；config 支持 min / max / decimals。",
      "defaultW": 3,
      "defaultH": 2,
      "configSchema": {
        "min": { "type": "number", "label": "量程下限", "default": 0 },
        "max": { "type": "number", "label": "量程上限", "default": 100 },
        "decimals": { "type": "integer", "label": "小数位", "min": 0, "max": 6, "default": 1 }
      }
    }
  ],
  "pages": [
    { "id": "about", "title": "插件示例", "icon": "plugin" }
  ],
  "devicePanels": []
}
