{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hmi.local/schemas/manifest.schema.json",
  "title": "设备包 manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "protocol"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
      "description": "包 id，小写点分（如 com.acme.pm3000）"
    },
    "name": { "type": "string", "minLength": 1 },
    "vendor": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "minHostVersion": { "type": "string" },
    "ui": {
      "type": "object",
      "description": "设备类型工作区默认页面；缺省时宿主使用内置四页",
      "properties": {
        "pages": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["id", "title", "components"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 64 },
              "title": { "type": "string", "minLength": 1, "maxLength": 120 },
              "icon": { "type": "string", "maxLength": 64 },
              "components": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "required": ["kind"],
                  "properties": {
                    "kind": {
                      "enum": ["overview", "dashboard", "tags", "settings"],
                      "description": "宿主组件：overview/dashboard/tags/settings"
                    },
                    "title": { "type": "string", "maxLength": 120 },
                    "config": { "type": ["object", "null"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "protocol": {
      "type": "object",
      "required": ["driver"],
      "properties": {
        "driver": { "type": "string", "enum": ["modbus-rtu"] },
        "defaults": {
          "type": "object",
          "properties": {
            "byteOrder": { "enum": ["abcd", "badc", "cdab", "dcba"] },
            "respTimeoutMs": { "type": "integer", "minimum": 20, "maximum": 10000 }
          }
        }
      }
    }
  }
}
