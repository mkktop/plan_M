{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hmi.local/schemas/manifest.schema.json",
  "title": "设备包 manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "protocol"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
      "description": "包 id，小写点分（如 com.acme.pm3000）"
    },
    "name": { "type": "string", "minLength": 1 },
    "vendor": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "minHostVersion": { "type": "string" },
    "ui": {
      "type": "object",
      "description": "设备类型工作区默认页面；缺省时宿主使用内置四页",
      "properties": {
        "pages": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["id", "title", "components"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 64 },
              "title": { "type": "string", "minLength": 1, "maxLength": 120 },
              "icon": { "type": "string", "maxLength": 64 },
              "components": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "required": ["kind"],
                  "properties": {
                    "kind": {
                      "enum": [
                        "overview",
                        "dashboard",
                        "tags",
                        "settings",
                        "value",
                        "gauge",
                        "switch",
                        "input",
                        "bits",
                        "core:value",
                        "core:gauge",
                        "core:switch",
                        "core:input",
                        "core:bits"
                      ],
                      "description": "宿主组件：overview/dashboard/tags/settings/core:value/core:gauge/core:switch/core:input/core:bits（裸名为兼容别名）"
                    },
                    "title": { "type": "string", "maxLength": 120 },
                    "rect": {
                      "type": "object",
                      "description": "12 列网格位置（0 基）；整页要么全部声明、要么全部省略（流式）",
                      "required": ["x", "y", "w", "h"],
                      "properties": {
                        "x": { "type": "integer", "minimum": 0, "maximum": 11 },
                        "y": { "type": "integer", "minimum": 0 },
                        "w": { "type": "integer", "minimum": 1, "maximum": 12 },
                        "h": { "type": "integer", "minimum": 1 }
                      },
                      "additionalProperties": false
                    },
                    "bind": {
                      "type": "object",
                      "description": "槽位 → 绑定。设备包只允许相对点绑定（point/bit），禁止绝对 tag",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "point": {
                            "type": "string",
                            "description": "包内相对点 id，渲染时解析为 <设备实例id>.<point>"
                          },
                          "bit": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 15,
                            "description": "位号，解析为 <设备实例id>.<point>.b<bit>"
                          },
                          "tag": {
                            "type": "string",
                            "description": "绝对 tag（仅用户页面允许；设备包内会被拒绝）"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "config": { "type": ["object", "null"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "protocol": {
      "type": "object",
      "required": ["driver"],
      "properties": {
        "driver": { "type": "string", "enum": ["modbus-rtu"] },
        "defaults": {
          "type": "object",
          "properties": {
            "byteOrder": { "enum": ["abcd", "badc", "cdab", "dcba"] },
            "respTimeoutMs": { "type": "integer", "minimum": 20, "maximum": 10000 }
          }
        }
      }
    }
  }
}
